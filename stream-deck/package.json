{
  "name": "poe2-companion-stream-deck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "pack": "npm run build && streamdeck pack com.poe2companion.deck.sdPlugin --output ../artifacts/stream-deck --no-file-list",

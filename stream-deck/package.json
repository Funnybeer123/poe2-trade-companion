    "typecheck": "tsc -p tsconfig.json",
    "validate": "streamdeck validate com.poe2companion.deck.sdPlugin"
  },
  "dependencies": { "@elgato/streamdeck": "2.1.2" },
  "devDependencies": { "@elgato/cli": "1.9.0", "@resvg/resvg-js": "2.6.2", "esbuild": "0.25.12", "fflate": "0.8.2" }
}

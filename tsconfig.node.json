{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@adapters/*": ["src/adapters/*"]
    }
  },
  "include": [
    "src/main/**/*.ts",
    "src/core/**/*.ts",
    "src/shared/**/*.ts",
    "src/adapters/**/*.ts",
    "src/renderer/env.d.ts",
    "tests/**/*.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "vue-shims.d.ts",
    "scripts/**/*.ts",
    "env.d.ts"
  ]
}
